# ==============================================================================
# IRONPULSE GYM BILLING OS — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Server Core
PORT=5000
NODE_ENV=production
APP_URL="http://localhost:5173"
FRONTEND_URL="http://localhost:5173"

# Database Connection (MySQL via Prisma ORM)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/ironpulse"

# Authentication & Security
# Generate a strong 64-character hex secret in production: openssl rand -hex 32
JWT_SECRET="replace_with_a_secure_random_jwt_secret_in_production"
JWT_EXPIRES_IN="1d"

# Automated Background Scheduler Protection
# Optional secret header (x-cron-secret) to trigger jobs from external Cloud Schedulers (e.g. Railway, Render, GCP)
CRON_SECRET="replace_with_random_cron_secret_for_cloud_triggers"

# ==============================================================================
# PAYMENT GATEWAY INTEGRATIONS (Stripe Direct Merchant / Card / ACH Processing)
# When keys are omitted, the engine returns CONFIGURATION_REQUIRED gracefully.
# Never invent fake tokens; real payments require genuine provider response.
# ==============================================================================
# Stripe Live / Test API Keys (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ==============================================================================
# MULTI-CHANNEL NOTIFICATION DISPATCHERS
# When keys are omitted, notifications are saved with status 'FAILED' or 'PENDING'
# and marked 'CONFIGURATION_REQUIRED' without crashing or faking delivery.
# ==============================================================================

# Email Dispatcher: Brevo (Sendinblue) or SendGrid API v3
# Primary supported: BREVO_API_KEY (or SENDGRID_API_KEY)
BREVO_API_KEY=
BREVO_FROM_EMAIL="notifications@yourgym.com"
BREVO_FROM_NAME="IronPulse Athletic Club"
# Alternative email provider:
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL="notifications@yourgym.com"

# SMS Dispatcher: Twilio Programmable Messaging (https://console.twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# WhatsApp Dispatcher: Meta WhatsApp Cloud API (https://developers.facebook.com)
META_WHATSAPP_PHONE_ID=
META_WHATSAPP_ACCESS_TOKEN=
