# ==============================================================================
# IRONPULSE GYM BILLING OS — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Server Core
PORT=5000
NODE_ENV=production
APP_URL="http://localhost:5173"

# Database Connection (MySQL via Prisma ORM)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/ironpulse"

# Authentication & Security
# Generate a strong 64-character hex secret in production: openssl rand -hex 32
JWT_SECRET="replace_with_a_secure_random_jwt_secret_in_production"
JWT_EXPIRES_IN="1d"

# ==============================================================================
# PAYMENT GATEWAY INTEGRATIONS (Real Merchant / ACH Processing)
# When keys are omitted, the engine operates safely in sandbox mode.
# Never invent fake tokens; real payments fail gracefully if unconfigured.
# ==============================================================================
# Stripe Live / Test API Keys (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ==============================================================================
# MULTI-CHANNEL NOTIFICATION DISPATCHERS
# When keys are omitted, notifications are saved with status 'PENDING'
# and marked 'CONFIGURATION_REQUIRED' without crashing or faking delivery.
# ==============================================================================
# Email Dispatcher: SendGrid API v3 (https://app.sendgrid.com/settings/api_keys)
SENDGRID_API_KEY="SG.your_sendgrid_api_key_here"
SENDGRID_FROM_EMAIL="notifications@ironpulse.club"

# SMS Dispatcher: Twilio Programmable Messaging (https://console.twilio.com)
TWILIO_ACCOUNT_SID="ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_PHONE_NUMBER="+15551234567"

# WhatsApp Dispatcher: Meta WhatsApp Cloud API v18.0 (https://developers.facebook.com)
META_WHATSAPP_PHONE_ID="100000000000000"
META_WHATSAPP_ACCESS_TOKEN="EAAG..."
