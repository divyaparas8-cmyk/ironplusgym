# Environment configuration for IronPulse Backend
PORT=5000
NODE_ENV=development

# MySQL Connection String via Prisma (XAMPP MySQL)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:PASSWORD@localhost:3306/ironpulse"

# JWT Authentication Configuration (Use a secure random string in production)
JWT_SECRET=your-development-jwt-secret
JWT_EXPIRES_IN=1d
